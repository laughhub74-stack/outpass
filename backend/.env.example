# ---- Required ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/homs
DATABASE_NAME=homs
# Comma-separated list of deployed frontend origins (no trailing slash)
FRONTEND_ORIGINS=https://your-frontend.example.com

# ---- Recommended ----
# Dedicated key for fingerprint encryption (so rotating SECRET_KEY does not
# make stored biometrics unreadable). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BIOMETRIC_ENCRYPTION_KEY=
# Session length in minutes (default 480 = 8h)
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Grace window (minutes) before out_date in which a gate EXIT scan is allowed
GATE_EXIT_EARLY_GRACE_MINUTES=30

# ---- SMTP (email alerts) ----
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=homs-alerts@your-college.edu

# ---- Seed script only (python seed_db.py) - no defaults, must be set ----
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
